class Student:
    def __init__(self, name, marks):
        # Member data (Attributes)
        self.name = name
        self.marks = marks

    def get_average(self):
        # Calculates the average of the marks list
        return sum(self.marks) / len(self.marks)

    def get_grade(self):
        # Calculates grade based on the average
        avg = self.get_average()
        if avg >= 90:
            return "A"
        elif avg >= 80:
            return "B"
        elif avg >= 70:
            return "C"
        elif avg >= 60:
            return "D"
        else:
            return "Fail"

# --- Input Section ---
name_input = input("Enter student name: ")
marks_list = []

for i in range(1, 6):
    m = float(input("Enter marks for subject " + str(i) + ": "))
    marks_list.append(m)

# --- Object Creation ---
# s1 is an instance (object) of the Student class
s1 = Student(name_input, marks_list)

# --- Output Section (No curly braces) ---
print("\n--- Student Report ---")
print("Name:          ", s1.name)
print("Average Marks: ", s1.get_average())
print("Final Grade:   ", s1.get_grade())
